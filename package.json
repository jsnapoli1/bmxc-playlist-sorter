{
  "name": "bmxc-playlist-sorter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plan which songs play during which parts of a week at summer camp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "cf:dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 execute bmxc-playlist-sorter --local --file=migrations/0001_init.sql",
    "db:migrate": "wrangler d1 migrations apply bmxc-playlist-sorter --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.125.0"
  }
}
