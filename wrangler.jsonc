{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmxc-playlist-sorter",
  "compatibility_date": "2026-08-22",

  // Assets-only Worker: Cloudflare serves the built files straight from its
  // edge, with no Worker invocation per request (and so no request billing).
  // The app is a client-side SPA with no backend, so there is no `main` script.
  "assets": {
    "directory": "./dist",
    // Deep links like /?code=... still resolve to index.html.
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
