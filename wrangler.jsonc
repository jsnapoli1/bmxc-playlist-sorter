{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmxc-playlist-sorter",
  "compatibility_date": "2026-08-22",
  "main": "worker/index.ts",

  // This login can reach several accounts; name the one that owns these
  // resources so a deploy can never land in the wrong place.
  "account_id": "9569781c361a80bd0b96dedbac0aca6d",

  // Publish on <name>.<subdomain>.workers.dev. Workers created through the
  // dashboard's Git-import flow can land with no route attached at all
  // ("No URLs enabled"), so state it here rather than relying on a default.
  "workers_dev": true,

  // Preview URLs would add more public hostnames, and each is a distinct
  // origin that Spotify would reject unless separately registered as a
  // redirect URI — so keep exactly one URL to register.
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links like /join/<token> still resolve to index.html.
    "not_found_handling": "single-page-application",

    // Without this, the asset layer answers browser *navigations* to
    // /api/* with index.html via the SPA fallback and the Worker never
    // runs — so clicking "Sign in with Spotify" loaded the app again
    // instead of redirecting to Spotify. curl saw the right 302 because
    // it does not send Sec-Fetch-Mode: navigate. Route /api/* to the
    // Worker first; everything else is still served straight from the
    // edge with no Worker invocation.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmxc-playlist-sorter",
      "database_id": "ea340ca4-6710-4cdb-ac8a-b7f6756b4a80",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "PLAN_ROOM",
        "class_name": "PlanRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed DOs are the current default and the cheaper tier.
      "new_sqlite_classes": ["PlanRoom"]
    }
  ],

  "vars": {
    // Public by design: a Spotify Client ID is not a secret. The matching
    // SPOTIFY_CLIENT_SECRET and ENCRYPTION_KEY are set with
    // `wrangler secret put` and never appear in this file.
    "SPOTIFY_CLIENT_ID": "ea33a7d4234f499bb3d33d9797e8cc54"
  },

  "observability": {
    "enabled": true
  },

  // --- bmxc.camp/playlist-builder ------------------------------------
  //
  // A second deploy of this same Worker, mounted under a path on the
  // marketing site's zone. The top-level config above stays exactly as it
  // was, so the workers.dev URL keeps working unchanged and can be compared
  // against this one.
  //
  // `routes` here (not `custom_domain`) because bmxc.camp already has a
  // custom domain pointing at the `bmxcsite` Worker. A path route is more
  // specific than that domain, so these two patterns win for
  // /playlist-builder while every other path still reaches the marketing
  // site. Note that a Worker on a route runs *in front of* the custom-domain
  // Worker rather than replacing it, so this Worker must answer everything
  // under its prefix and never fall through with a bare fetch(request).
  "env": {
    "playlist": {
      // Named for the public URL it serves, rather than letting wrangler
      // derive <name>-<env> from the environment key.
      "name": "bmxc-playlist-builder",

      // The path route is the only public URL for this deploy.
      "workers_dev": false,
      "preview_urls": false,

      // bmxcsite answers on both the bare domain and www (both are custom
      // domains on that Worker, and www does not redirect), so the app has
      // to cover both or a visitor who arrived via www gets the marketing
      // site's SPA fallback instead of the app.
      //
      // redirect_uri is built from whichever host served the request, so
      // BOTH callback URIs must be registered in the Spotify dashboard:
      //   https://bmxc.camp/playlist-builder/api/auth/callback
      //   https://www.bmxc.camp/playlist-builder/api/auth/callback
      // and likewise both app-root URIs for the browser PKCE flow:
      //   https://bmxc.camp/playlist-builder/
      //   https://www.bmxc.camp/playlist-builder/
      "routes": [
        { "pattern": "bmxc.camp/playlist-builder", "zone_name": "bmxc.camp" },
        { "pattern": "bmxc.camp/playlist-builder/*", "zone_name": "bmxc.camp" },
        { "pattern": "www.bmxc.camp/playlist-builder", "zone_name": "bmxc.camp" },
        { "pattern": "www.bmxc.camp/playlist-builder/*", "zone_name": "bmxc.camp" }
      ],

      "vars": {
        "SPOTIFY_CLIENT_ID": "ea33a7d4234f499bb3d33d9797e8cc54",

        // Must match the `base` the SPA in dist/ was built with, which is
        // why `npm run deploy:playlist` sets both from one value.
        "APP_BASE": "/playlist-builder"
      },

      // Inherited config is NOT merged into a named environment — each of
      // these has to be restated or the deploy silently loses the binding.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bmxc-playlist-sorter",
          "database_id": "ea340ca4-6710-4cdb-ac8a-b7f6756b4a80",
          "migrations_dir": "migrations"
        }
      ],

      "durable_objects": {
        "bindings": [{ "name": "PLAN_ROOM", "class_name": "PlanRoom" }]
      },

      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanRoom"] }],

      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",

        // Everything under the mount goes to the Worker first so it can
        // strip the prefix before asking the asset store, which keys assets
        // by their path relative to dist/ with no prefix.
        "run_worker_first": ["/playlist-builder", "/playlist-builder/*"]
      },

      "observability": { "enabled": true }
    }
  }
}
