# Client ID of the shared "Camp Playlist Sorter" Spotify app, baked into the
# deployed build so users get a single "Connect Spotify" button instead of
# having to register a Spotify app of their own.
#
# This is NOT a secret. A PKCE public client has no client secret, and this ID
# is served inside the JavaScript bundle of the public site regardless. What
# protects the app is Spotify's redirect-URI allowlist: an authorization code
# can only ever be returned to a URI registered on the app itself.
#
# To point the site at a different Spotify app, change this value and redeploy.
VITE_SPOTIFY_CLIENT_ID=ea33a7d4234f499bb3d33d9797e8cc54
