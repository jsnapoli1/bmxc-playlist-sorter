# Bake a Spotify Client ID into the build so users just click "Connect
# Spotify" instead of registering their own Spotify app. A PKCE client ID is
# public by design — it is not a secret. Copy this file to .env to use it
# locally; for the deployed site set the same variable as a Cloudflare
# Workers Builds build variable.
VITE_SPOTIFY_CLIENT_ID=
